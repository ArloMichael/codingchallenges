       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.plot(days, temps)\n",
    "\n",
    "plt.xlabel(\"Day of the month\")\n",
    "plt.ylabel(\"Temperature (C)\")\n",
    "plt.title(\"Avg daily temp\")\n",
    "\n",
    "plt.show()"
   ]
  }
