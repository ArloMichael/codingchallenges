   "source": [
    "import matplotlib.pyplot as plt\n",
    "from random import randint"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 50,
   "id": "1449c64b",
   "metadata": {},
   "outputs": [],
   "source": [
    "days = list(range(1, 31))\n",
    "temps = [randint(20, 30) for _ in days]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 51,
   "id": "4c4106bd",
   "metadata": {},
   "outputs": [
    {
     "data": {
